<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow Diamond/Ring -->
    <path
        android:pathData="M54,28 L74,54 L54,80 L34,54 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#3300E5FF"
        android:fillColor="#00000000" />

    <!-- Corner digital nodes -->
    <path
        android:pathData="M54,24 L54,27 M54,81 L54,84 M24,54 L27,54 M81,54 L84,54"
        android:strokeWidth="2.5"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />

    <!-- Digital Nova Starburst (Cyan to Blue Gradient) -->
    <path
        android:pathData="M54,26 C54,42 66,54 82,54 C66,54 54,66 54,82 C54,66 42,54 26,54 C42,54 54,42 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.5" android:color="#00A3FF" />
                <item android:offset="1.0" android:color="#2979FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Nova Glow (White-Cyan) -->
    <path
        android:pathData="M54,39 C54,48 60,54 69,54 C60,54 54,60 54,69 C54,60 48,54 39,54 C48,54 54,48 54,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="39"
                android:endX="69"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#70F3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Core Sparkle -->
    <path
        android:pathData="M54,50 C54,52 56,54 58,54 C56,54 54,56 54,58 C54,56 52,54 50,54 C52,54 54,52 54,50 Z"
        android:fillColor="#FFFFFF" />

    <!-- Diagonal Accent Beams -->
    <path
        android:pathData="M42,42 L38,38 M66,66 L70,70 M66,42 L70,38 M42,66 L38,70"
        android:strokeWidth="1.8"
        android:strokeColor="#8000E5FF"
        android:strokeLineCap="round" />
</vector>
